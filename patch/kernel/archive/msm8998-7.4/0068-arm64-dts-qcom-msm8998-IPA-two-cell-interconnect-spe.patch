From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Ricardo Pardini <ricardo@pardini.net>
Date: Sun, 22 Nov 2026 00:11:49 +0100
Subject: [PATCH] arm64: dts: qcom: msm8998: IPA: two-cell interconnect
 specifiers

The MSM8998 icc-rpm provider has #interconnect-cells = <2>; the IPA
paths were written for one cell, so the third cell was parsed as a
phandle (cpu@1) and fw_devlink kept IPA deferred forever. Add the tags.
---
 arch/arm64/boot/dts/qcom/msm8998.dtsi | 9 ++++++---
 1 file changed, 6 insertions(+), 3 deletions(-)

diff --git a/arch/arm64/boot/dts/qcom/msm8998.dtsi b/arch/arm64/boot/dts/qcom/msm8998.dtsi
index ec199002d6bd..1ae883dd08d6 100644
--- a/arch/arm64/boot/dts/qcom/msm8998.dtsi
+++ b/arch/arm64/boot/dts/qcom/msm8998.dtsi
@@ -2000,9 +2000,12 @@ ipa: ipa@1e40000 {
 			<&aggre2_noc MASTER_IPA 0 &system_noc SLAVE_IMEM 0>,
 			<&gladiator_noc MASTER_APPSS_PROC 0 &config_noc SLAVE_IPA_CFG 0>
 */
-			interconnects = <&a2noc MASTER_IPA &bimc SLAVE_EBI>,
-					<&a2noc MASTER_IPA &snoc SLAVE_IMEM>,
-					<&gnoc MASTER_APSS_PROC &cnoc SLAVE_IPA>;
+			interconnects = <&a2noc MASTER_IPA QCOM_ICC_TAG_ALWAYS
+					 &bimc SLAVE_EBI QCOM_ICC_TAG_ALWAYS>,
+					<&a2noc MASTER_IPA QCOM_ICC_TAG_ALWAYS
+					 &snoc SLAVE_IMEM QCOM_ICC_TAG_ALWAYS>,
+					<&gnoc MASTER_APSS_PROC QCOM_ICC_TAG_ACTIVE_ONLY
+					 &cnoc SLAVE_IPA QCOM_ICC_TAG_ACTIVE_ONLY>;
 			interconnect-names = "memory",
 					     "imem",
 					     "config";
-- 
2.47.3

